{
  "rules": {
    "obecnosc": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['f', 'on', 't']) && newData.child('f').isString() && newData.child('f').val().length <= 60 && newData.child('on').isBoolean() && newData.child('t').isNumber()",
        "$inne": { ".validate": "$inne === 'f' || $inne === 't' || $inne === 'on'" }
      }
    }
  }
}
