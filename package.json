{
  "name": "fantasy-rp",
  "productName": "Fantasy RP dla autystów",
  "version": "0.3.3",
  "author": "Zeren Erlethaden",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "app": "vite build && electron .",
    "instalator": "vite build && electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "firebase": "^13.0.0",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "build": {
    "appId": "pl.erlethaden.fantasyrp",
    "electronDist": "node_modules/electron/dist",
    "copyright": "© Zeren Erlethaden",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "artifactName": "Fantasy-RP-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Fantasy RP",
      "language": "1045",
      "installerLanguages": [
        "pl_PL"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Erlethaden",
        "repo": "Fantasy_RP"
      }
    ]
  }
}
