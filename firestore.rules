rules_version = '2';
// Etap 4.4–4.5: role + część tajna + propozycje + logi. Wklej w: Firebase → Firestore Database → Reguły (Rules) → Opublikuj.
// - dane gry (frakcje, bohaterowie, zasoby, tury, jednostki) ZAPISUJĄ tylko GM i admin; czytają członkowie (GM, admin, gracz, obserwator)
// - oczekujący nie widzi danych gry, tylko swój profil
// - admin nadaje każdą rolę; GM tylko oczekujący/gracz/obserwator i nie rusza kont GM/admin; nikt nie zmienia własnej roli
// - konto admina rozpoznawane po e-mailu Google (zweryfikowanym) — tylko ono może utworzyć sobie profil z rolą admin
// - część tajna frakcji (tajne_zasoby / tajne_jednostki / tajne_statusy) czyta GM, admin i gracz tej frakcji;
//   pozostali członkowie tylko wtedy, gdy GM ustawił w dokumencie frakcji jawne.<rodzaj> = true
// - notatki_gracza: czyta i pisze gracz tej frakcji + GM; notatki_gm: tylko GM/admin
// - nazwy_osad/{prowincja} (6.2, 2026-10-19): nazwy osad zmienia GM albo gracz, którego frakcja ma tę prowincję (gra/prowincje)
// - propozycje (4.4, 7.12–7.15): gracz proponuje opis państwa i bohaterów, stolicę i budynki we własnych prowincjach, cel własnej armii, traktat
//   (najpierw zgoda graczy-stron) i zerwanie swojego traktatu; GM akceptuje — przyjęta jest od razu kasowana
service cloud.firestore {
  match /databases/{database}/documents {
    function zalogowany() { return request.auth != null; }
    function adminEmail() {
      return zalogowany() && request.auth.token.email == "3philar@gmail.com" && request.auth.token.email_verified == true;
    }
    function sciezkaProfilu() { return /databases/$(database)/documents/uzytkownicy/$(request.auth.uid); }
    function rola() { return zalogowany() && exists(sciezkaProfilu()) ? get(sciezkaProfilu()).data.rola : ""; }
    function admin() { return adminEmail() || rola() == "admin"; }
    function gm() { return admin() || rola() == "gm"; }
    function czlonek() { return gm() || rola() in ["gracz", "obserwator"]; }
    function rolaZwykla(r) { return r in ["oczekujacy", "gracz", "obserwator"]; }
    function mojaFrakcja() { return zalogowany() && exists(sciezkaProfilu()) ? get(sciezkaProfilu()).data.frakcja : ""; }
    function wlasciciel(f) { return czlonek() && mojaFrakcja() == f; }
    function jawne(f, rodzaj) {
      return czlonek() && get(/databases/$(database)/documents/frakcje/$(f)).data.get("jawne", {}).get(rodzaj, false) == true;
    }
    function polaProfilu() { return request.resource.data.keys().hasOnly(["email", "nazwa", "rola", "frakcja", "utworzono"]); }

    match /uzytkownicy/{uid} {
      allow read: if (zalogowany() && request.auth.uid == uid) || gm();
      allow create: if zalogowany() && request.auth.uid == uid && polaProfilu() && request.resource.data.frakcja == ""
        && (request.resource.data.rola == "oczekujacy" || (adminEmail() && request.resource.data.rola == "admin"));
      // admin może zmienić sobie tylko państwo (też gra); własnej roli nikt nie zmienia
      allow update: if zalogowany() && request.auth.uid == uid && admin() && polaProfilu()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["frakcja"]);
      allow update: if zalogowany() && request.auth.uid != uid && polaProfilu()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["rola", "frakcja"])
        && (admin() || (rola() == "gm" && rolaZwykla(resource.data.rola) && rolaZwykla(request.resource.data.rola)));
      allow delete: if admin();
    }
    match /frakcje/{id} { allow read: if czlonek(); allow write: if gm(); }
    match /bohaterowie/{id} { allow read: if czlonek(); allow write: if gm(); }
    match /gra/{id} { allow read: if czlonek(); allow write: if gm(); }
    // nazwy osad (6.2): jeden mały dokument na prowincję { n: {numer osady: nazwa} }; pisze GM albo gracz, którego frakcja ma tę prowincję
    function mojaProwincja(pid) {
      return czlonek() && mojaFrakcja() != ""
        && get(/databases/$(database)/documents/gra/prowincje).data.p.get(pid, {}).get("wlasciciel", "") == mojaFrakcja();
    }
    match /nazwy_osad/{pid} {
      allow read: if czlonek();
      allow create, update: if (gm() || mojaProwincja(pid))
        && request.resource.data.keys().hasOnly(["n"]) && request.resource.data.n is map && request.resource.data.n.size() <= 10;
      allow delete: if gm() || mojaProwincja(pid);
    }
    match /tajne_zasoby/{f} { allow read: if gm() || wlasciciel(f) || jawne(f, "zasoby"); allow write: if gm(); }
    match /tajne_jednostki/{f} { allow read: if gm() || wlasciciel(f) || jawne(f, "jednostki"); allow write: if gm(); }
    // budynki i złoża (6.4): domyślnie jawne — tajne dopiero, gdy GM ustawi jawne.budynki = false
    match /tajne_budynki/{f} { allow read: if gm() || wlasciciel(f) || (czlonek() && get(/databases/$(database)/documents/frakcje/$(f)).data.get("jawne", {}).get("budynki", true) != false); allow write: if gm(); }
    // armie (7.1): skład, dowódca, trasa — jak zasoby (domyślnie tajne); pozycje znaczników w gra/armie (jawne)
    match /tajne_armie/{f} { allow read: if gm() || wlasciciel(f) || jawne(f, "armie"); allow write: if gm(); }
    // raporty bitew (7.1h): skład obu stron — czyta GM i gracze krajów biorących udział
    match /bitwy/{id} { allow read: if gm() || (czlonek() && mojaFrakcja() in resource.data.uczestnicy); allow write: if gm(); }
    // traktaty (7.4): jawne czytają wszyscy, tajne tylko strony i GM; pisze GM
    match /traktaty/{id} { allow read: if gm() || (czlonek() && (resource.data.tajny == false || mojaFrakcja() in resource.data.strony)); allow write: if gm(); }
    // bloki (7.9): jawne czytają wszyscy, tajne — członkowie i zaproszeni (pole widza) oraz GM; GM pisze wszystko.
    // Gracz (7.9b): zakłada blok (jedyny członek i lider), przyjmuje / odrzuca swoje zaproszenie, wychodzi, zgłasza wnioski i głosuje;
    // inne zmiany: lider w trybie lidera albo członek wykonujący przegłosowany wniosek (wykonano = id wniosku, który miał większość „za”).
    // Rozwiązanie przez graczy = pole rozwiazany (usuwa tylko GM).
    function polaBlokuOk(d) {
      return d.keys().hasOnly(["nazwa", "skrot", "rodzaj", "kolor", "opis", "czlonkowie", "zaproszeni", "widza", "tajny", "tryb", "lider", "traktaty", "tura", "wnioski", "wykonano", "rozwiazany"])
        && d.nazwa is string && d.nazwa.size() <= 80 && d.opis is string && d.opis.size() <= 5000 && d.czlonkowie is list && d.zaproszeni is list
        && d.widza == d.czlonkowie.concat(d.zaproszeni) && d.tajny is bool && d.tryb in ["glosowanie", "lider"] && d.get("wnioski", {}) is map;   // bloki GM z 7.9a mogą nie mieć pola wnioski
    }
    function zmienioneBloku() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function przeglosowany() {
      return request.resource.data.get("wykonano", "") in resource.data.wnioski && !(request.resource.data.wykonano in request.resource.data.wnioski)
        && resource.data.wnioski[request.resource.data.wykonano].za.size() * 2 > resource.data.czlonkowie.size();
    }
    match /bloki/{id} {
      allow read: if gm() || (czlonek() && (resource.data.tajny == false || mojaFrakcja() in resource.data.widza));
      allow write: if gm();
      allow create: if czlonek() && mojaFrakcja() != "" && polaBlokuOk(request.resource.data) && request.resource.data.czlonkowie == [mojaFrakcja()]
        && request.resource.data.lider == mojaFrakcja() && request.resource.data.wnioski == {} && !("rozwiazany" in request.resource.data);
      allow update: if czlonek() && mojaFrakcja() != "" && polaBlokuOk(request.resource.data) && (
        (mojaFrakcja() in resource.data.zaproszeni && zmienioneBloku().hasOnly(["czlonkowie", "zaproszeni", "widza"])
          && request.resource.data.czlonkowie == resource.data.czlonkowie.concat([mojaFrakcja()]) && request.resource.data.zaproszeni == resource.data.zaproszeni.removeAll([mojaFrakcja()]))
        || (mojaFrakcja() in resource.data.zaproszeni && zmienioneBloku().hasOnly(["zaproszeni", "widza"]) && request.resource.data.zaproszeni == resource.data.zaproszeni.removeAll([mojaFrakcja()]))
        || (mojaFrakcja() in resource.data.czlonkowie && zmienioneBloku().hasOnly(["czlonkowie", "widza", "lider"]) && request.resource.data.czlonkowie == resource.data.czlonkowie.removeAll([mojaFrakcja()]))
        || (mojaFrakcja() in resource.data.czlonkowie && zmienioneBloku().hasOnly(["wnioski", "wykonano"]))
        || (resource.data.tryb == "lider" && resource.data.lider == mojaFrakcja())
        || (mojaFrakcja() in resource.data.czlonkowie && przeglosowany()));
    }
    // kronika (7.2): jawne wpisy czytają wszyscy, tajne — kraje z listy „widza” i GM; pisze GM, gracz tylko wpis o bloku ze swoim krajem (7.9b)
    match /kronika/{id} {
      allow read: if gm() || (czlonek() && (resource.data.tajny == false || mojaFrakcja() in resource.data.widza));
      allow write: if gm();
      allow create: if czlonek() && mojaFrakcja() != "" && request.resource.data.typ == "blok" && mojaFrakcja() in request.resource.data.kraje
        && request.resource.data.keys().hasOnly(["tura", "czas", "typ", "tekst", "kraje", "tajny", "widza"]) && request.resource.data.tekst is string && request.resource.data.tekst.size() <= 600;
    }
    match /tajne_statusy/{f} { allow read: if gm() || wlasciciel(f) || jawne(f, "statusy"); allow write: if gm(); }
    match /notatki_gracza/{f} {
      allow read: if gm() || wlasciciel(f);
      allow write: if gm() || (wlasciciel(f) && request.resource.data.keys().hasOnly(["tekst"]) && request.resource.data.tekst.size() <= 5000);
    }
    match /notatki_gm/{f} { allow read, write: if gm(); }
    // propozycje zmian: gracz składa tylko dla swojego państwa i jego bohaterów, tylko dozwolone pola; GM rozpatruje;
    // gracz czyta i wycofuje (dopóki czeka) tylko swoje
    function nowaPropozycja() {
      let d = request.resource.data;
      return czlonek() && d.uid == request.auth.uid && d.frakcja == mojaFrakcja() && d.status == "czeka"
        && d.komentarz == "" && d.rozpatrzono == "" && d.rozpatrzyl == ""
        && d.keys().hasOnly(["czas", "uid", "email", "frakcja", "cel", "celId", "nazwa", "zmiany", "przed", "status", "komentarz", "rozpatrzono", "rozpatrzyl", "strony", "zgody"])
        && ((d.cel == "frakcja" && d.celId == mojaFrakcja()
              && d.zmiany.keys().hasOnly(["stolica", "ustroj", "wladca", "godlo", "motto", "specjalizacja", "tereny", "opis"]))
          || (d.cel == "bohater" && get(/databases/$(database)/documents/bohaterowie/$(d.celId)).data.frakcja == mojaFrakcja()
              && d.zmiany.keys().hasOnly(["tytul", "funkcja", "wiek", "bron", "opis"]))
          // 7.12–7.13: stolica i budynki tylko we własnej prowincji (celId = id prowincji)
          || (d.cel == "stolica" && mojaProwincja(d.celId) && d.zmiany.keys().hasOnly(["osada"]) && d.zmiany.osada is int)
          || (d.cel == "budynki" && mojaProwincja(d.celId) && d.zmiany.keys().hasOnly(["budynki"])
              && d.zmiany.budynki.keys().hasOnly(["sloty", "zloze"]) && d.zmiany.budynki.sloty is list
              && d.zmiany.budynki.sloty.size() <= 30 && d.zmiany.budynki.zloze is string)
          // 7.14: cel własnej armii (celId = id armii z gra/armie)
          || (d.cel == "ruch" && get(/databases/$(database)/documents/gra/armie).data.a.get(d.celId, {}).get("f", "") == mojaFrakcja()
              && d.zmiany.keys().hasOnly(["cel"]) && d.zmiany.cel is map && d.zmiany.cel.keys().hasOnly(["p", "o", "armia"]))
          // 7.8d: cel własnej floty (celId = id floty z gra/armie.fl, cel = nr akwenu)
          || (d.cel == "rejs" && get(/databases/$(database)/documents/gra/armie).data.fl.get(d.celId, {}).get("f", "") == mojaFrakcja()
              && d.zmiany.keys().hasOnly(["cel"]) && d.zmiany.cel is int)
          // 7.15: nowy traktat — autor jest stroną i od razu się zgadza; strony propozycji = strony traktatu (po nich czytają i dają zgodę)
          || (d.cel == "traktat" && d.celId == "" && d.strony is list && mojaFrakcja() in d.strony && d.strony.size() >= 2 && d.strony.size() <= 30
              && d.zgody.keys().hasOnly([mojaFrakcja()]) && d.zgody[mojaFrakcja()] == true
              && d.zmiany.keys().hasOnly(["traktat"]) && d.zmiany.traktat.keys().hasOnly(["nazwa", "typ", "strony", "tajny", "opis"])
              && d.zmiany.traktat.strony == d.strony && d.zmiany.traktat.tajny is bool)
          // 7.15: zerwanie traktatu, w którym frakcja gracza jest stroną (bez zgody innych)
          || (d.cel == "zerwanie" && mojaFrakcja() in get(/databases/$(database)/documents/traktaty/$(d.celId)).data.strony
              && d.strony == [mojaFrakcja()] && d.zgody == {} && d.zmiany.keys().hasOnly(["zerwij"])));
    }
    match /propozycje/{id} {
      allow create: if nowaPropozycja();
      allow read: if gm() || (zalogowany() && resource.data.uid == request.auth.uid) || (czlonek() && mojaFrakcja() in resource.data.strony);
      // strona traktatu (7.15) zmienia tylko własny wpis w „zgody” (true = zgoda, false = odmowa), dopóki propozycja czeka
      allow update: if czlonek() && resource.data.status == "czeka" && mojaFrakcja() in resource.data.strony
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["zgody"])
        && request.resource.data.zgody.diff(resource.data.zgody).affectedKeys().hasOnly([mojaFrakcja()])
        && request.resource.data.zgody[mojaFrakcja()] is bool;
      allow update: if gm() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "komentarz", "rozpatrzono", "rozpatrzyl"]);
      allow delete: if gm() || (zalogowany() && resource.data.uid == request.auth.uid && resource.data.status == "czeka");
    }
    // logi: wpis dodaje członek gry tylko pod własnym kontem (mały, o stałych polach, do 40 zmienionych pól); czyta i kasuje tylko admin
    match /logi/{id} {
      allow create: if czlonek() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(["czas", "uid", "email", "typ", "co", "kod", "zmiany"])
        && request.resource.data.typ in ["zmiana", "blad"] && request.resource.data.co.size() <= 30
        && (!("zmiany" in request.resource.data) || request.resource.data.zmiany.size() <= 40);   // zmiany: [{d: dokument, p: pole, z: było, n: jest}]
      allow read, delete: if admin();
    }
    // wszystko inne: zamknięte
  }
}
